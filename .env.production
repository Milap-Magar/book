# Read by `vite build` only (not by `vite dev`). Committed on purpose: it holds no secrets.
#
# The production host serves static files and does not forward /api, so the browser calls the
# API on its own origin. Must include /api/v1. A VITE_API_URL set on the host overrides this.
VITE_API_URL=https://java-book-api.onrender.com/api/v1
