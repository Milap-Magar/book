# Copy to .env and change only what you need.

# Where the Vite dev server (and `vite preview`) forwards /api requests.
# The hosted API, or http://localhost:8080 for a Spring Boot app on this machine.
API_PROXY_TARGET=https://java-book-api.onrender.com

# Base URL the browser uses for API calls. Leave unset to call /api/v1 on the page's own origin:
# the dev proxy in development, a rewrite rule on the host in production (see README, Deploying).
# Set it only if the browser must call the API on another origin directly,
# e.g. https://java-book-api.onrender.com/api/v1
# VITE_API_URL=

# Turn on once the API has file storage (resources, downloads, book PDFs and covers).
# VITE_FEATURE_FILES=true
