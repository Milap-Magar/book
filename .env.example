# Copy to .env.local and change only what you need. Both are optional in development.

# Where the Vite dev server forwards /api requests (your Spring Boot app).
API_PROXY_TARGET=http://localhost:8080

# Base URL the browser uses for API calls. Leave unset to use the dev proxy (/api/v1).
# Set it in production if the API is on another origin, e.g. https://api.example.com/api/v1
# VITE_API_URL=
